    {
      "name": "Households",
      "item": [
        {
          "name": "List households",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/households?barangay={{barangay}}&purok=All%20Puroks&status=ALL&verification=ALL&search=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "households"
              ],
              "query": [
                {
                  "key": "barangay",
                  "value": "{{barangay}}"
                },
                {
                  "key": "purok",
                  "value": "All Puroks",
                  "description": "Use All Puroks to skip the purok filter."
                },
                {
                  "key": "status",
                  "value": "ALL",
                  "description": "SAFE, MODERATE, EMERGENCY, or ALL."
                },
                {
                  "key": "verification",
                  "value": "ALL",
                  "description": "Pending, Verified, or ALL."
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Optional search across head of family, ID, contact number, and address."
                }
              ]
            }
          }
        },
        {
          "name": "Register household",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"headOfFamily\": \"Juan Dela Cruz\",\n  \"birthday\": \"1985-03-12\",\n  \"age\": 41,\n  \"contactNumber\": \"09171234567\",\n  \"numberOfMembers\": 4,\n  \"houseNumber\": \"12-A\",\n  \"purok\": \"Purok 1\",\n  \"barangay\": \"{{barangay}}\",\n  \"completeAddress\": \"12-A, Purok 1, Buang, Albay\",\n  \"location\": {\n    \"lat\": 13.3421,\n    \"lng\": 123.698\n  },\n  \"status\": \"SAFE\",\n  \"statusNote\": \"\",\n  \"evacuationCenterId\": null,\n  \"verificationStatus\": \"Pending\",\n  \"specialNeeds\": [],\n  \"familyMembers\": [\n    {\n      \"id\": \"member-1\",\n      \"name\": \"Juan Dela Cruz\",\n      \"age\": 41,\n      \"relationship\": \"Head of Family\",\n      \"specialCategory\": \"None\"\n    }\n  ],\n  \"officerName\": \"Barangay DRRM Desk\",\n  \"officerRole\": \"DRRM Officer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/households",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "households"
              ]
            },
            "description": "The `id` field is optional; if omitted, the API generates one."
          }
        },
        {
          "name": "Update household status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"MODERATE\",\n  \"statusNote\": \"Water level rising; monitor the household.\",\n  \"evacuationCenterId\": null,\n  \"officerName\": \"Juan Dela Cruz\",\n  \"officerRole\": \"Duty Officer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/households/{{householdId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "households",
                "{{householdId}}",
                "status"
              ]
            }
          }
        },
