                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/households/{{householdId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "households",
                "{{householdId}}"
              ]
            },
            "description": "Permanently deletes the household and its associated relief distribution records."
          }
        }
      ]
